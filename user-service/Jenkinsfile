pipeline {
    agent any

    environment {
        IMAGE    = 'ghcr.io/nerodelly/user-service'
        REGISTRY = 'ghcr.io'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── CI ────────────────────────────────────────────────────────────────
        stage('Compile') {
            steps {
                sh 'mvn compile -pl user-service -am -DskipTests -q'
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    mvn test -pl user-service \
                        -Deureka.client.enabled=false \
                        -Dspring.cloud.config.enabled=false \
                        -Dspring.autoconfigure.exclude=\
org.springframework.boot.autoconfigure.amqp.RabbitAutoConfiguration,\
org.springframework.boot.autoconfigure.security.oauth2.resource.servlet.OAuth2ResourceServerAutoConfiguration
                '''
            }
            post {
                always {
                    junit 'user-service/target/surefire-reports/*.xml'
                }
            }
        }

        // ── CD ────────────────────────────────────────────────────────────────
        stage('Build & Push Docker image') {
            when { branch 'main' }
            steps {
                withCredentials([string(credentialsId: 'ghcr-token', variable: 'GHCR_TOKEN')]) {
                    sh '''
                        echo "$GHCR_TOKEN" | docker login ghcr.io -u nerodelly --password-stdin
                        docker build -t $IMAGE:$BUILD_NUMBER -t $IMAGE:latest \
                            -f user-service/Dockerfile .
                        docker push $IMAGE:$BUILD_NUMBER
                        docker push $IMAGE:latest
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=$KUBECONFIG_FILE
                        sed "s|IMAGE_TAG|$BUILD_NUMBER|g" k8s/user-service/deployment.yml | kubectl apply -f -
                        kubectl apply -f k8s/user-service/service.yml
                        kubectl rollout status deployment/user-service -n learnivo --timeout=180s
                    '''
                }
            }
        }
    }

    post {
        success { echo "✅ user-service pipeline passed" }
        failure { echo "❌ user-service pipeline failed" }
    }
}
